# Credentials for the live contract tests and the fixture recorder.
#
# Copy this file to .env and fill it in. .env is gitignored; never commit real
# credentials, and never paste them into a test file.
#
#   cp .env.example .env
#
# Neither the offline test suite nor CI reads these. Only `pytest -m live` and
# scripts/record_fixtures.py do, and both will prompt you for the login OTP.

VTOP_USERNAME=
VTOP_PASSWORD=
